# Appwrite REST endpoint. Cloud default: https://cloud.appwrite.io/v1
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1

# Project ID  -> Appwrite console > Settings > Project ID
VITE_APPWRITE_PROJECT=

# Database ID -> Databases > (your database) > Overview
VITE_APPWRITE_DATABASE=

# Collection ID -> Databases > (db) > (collection) > Overview
VITE_APPWRITE_COLLECTION=
